# Gmail SMTP credentials used to send quote-request emails from the contact form.
# SMTP_PASS must be a Gmail App Password (not the regular account password) —
# generate one at https://myaccount.google.com/apppasswords
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
QUOTE_TO_EMAIL=recipient@example.com
